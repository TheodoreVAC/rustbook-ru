# Normalise line endings: the original Rust sources use LF.
* text=auto eol=lf

*.rs   text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.json text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.shieber binary

# GitHub language statistics: keep Rust sources at the top of the bar.
# Build artefacts of the book (HTML, PDF, extracted texts) — generated.
ru/build/**    linguist-generated
ru/source/**   linguist-generated
# Vendored original project (PDF editions, original code) — not ours.
original/**    linguist-vendored
# PDF editions — documentation, not code.
*.pdf          linguist-documentation
